<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B8B8D1"
                android:textSize="14sp"
                android:maxLines="1"
                android:layout_marginTop="2dp"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/notification_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:progressTint="#6A4C93"
        android:progressBackgroundTint="#2D2142"
        android:max="100"
        android:progress="0" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/notification_shuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_shuffle_off"
            android:background="@drawable/notification_button_3d"
            android:contentDescription="Shuffle"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/notification_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@drawable/notification_button_3d"
            android:contentDescription="Previous"
            android:tint="#FFFFFF"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/notification_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="14dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/notification_play_button_3d"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Play/Pause"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/notification_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next"
            android:background="@drawable/notification_button_3d"
            android:contentDescription="Next"
            android:tint="#FFFFFF"
            android:layout_marginStart="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/notification_repeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_repeat_off"
            android:background="@drawable/notification_button_3d"
            android:contentDescription="Repeat"
            android:layout_marginStart="6dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
