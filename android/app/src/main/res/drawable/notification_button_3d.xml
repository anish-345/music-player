<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer 1 (Outer) -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#1A000000"/>
            <size android:width="48dp" android:height="48dp"/>
        </shape>
    </item>
    
    <!-- Shadow Layer 2 (Middle) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#33000000"/>
        </shape>
    </item>
    
    <!-- Main Button with Gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#2D3142"
                android:centerColor="#3A3D52"
                android:endColor="#2E2440"
                android:type="linear"/>
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF"/>
        </shape>
    </item>
    
    <!-- Top Highlight -->
    <item
        android:top="4dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="24dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF"/>
        </shape>
    </item>
</layer-list>
